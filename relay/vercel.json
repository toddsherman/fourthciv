{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "npm ci --ignore-scripts",
  "outputDirectory": "public",
  "functions": { "api/index.mjs": { "maxDuration": 15 } },
  "rewrites": [ { "source": "/(.*)", "destination": "/api/index?route=$1" } ]
}
